NODE_ENV=development
PORT=4000
# Only needed when the frontend is served from a different origin than the API (comma-separated list).
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the app (1 on Render/Railway/most PaaS). Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1
# Folder with the built frontend (frontend/dist by default). The API serves it when it exists.
# STATIC_DIR=
MONGODB_URI=mongodb://127.0.0.1:27017/scholarpath
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PINECONE_API_KEY=
PINECONE_INDEX_NAME=scholarpath-index
PINECONE_NAMESPACE=official-scholarships
UPLOAD_DIR=./uploads

# Required to protect source-ingestion/admin endpoints. Generate a long random secret
# (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"). Admin endpoints stay disabled while blank.
ADMIN_API_TOKEN=

# Optional SMTP notifications (leave blank to disable email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Inngest keys for deployed notification jobs (leave blank for the local Inngest dev server)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
